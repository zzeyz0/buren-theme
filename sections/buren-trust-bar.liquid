{% comment %}
  Barra de garantías (Büren): ícono + título + texto por bloque.
  Un bloque puede mostrar los logos de Webpay y Mercado Pago (snippet buren-payment-icons).
{% endcomment %}

{{ 'buren-trust-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="buren-trust color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="buren-trust__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <ul
        class="buren-trust__list buren-trust__list--{{ section.blocks.size }} buren-trust__list--{{ section.settings.layout }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li class="buren-trust__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="buren-trust__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    {{- 'icon-truck.svg' | inline_asset_content -}}
                  {%- when 'lock' -%}
                    {{- 'icon-lock.svg' | inline_asset_content -}}
                  {%- when 'return' -%}
                    {{- 'icon-return.svg' | inline_asset_content -}}
                  {%- when 'check_mark' -%}
                    {{- 'icon-check-mark.svg' | inline_asset_content -}}
                  {%- when 'box' -%}
                    {{- 'icon-box.svg' | inline_asset_content -}}
                  {%- when 'chat_bubble' -%}
                    {{- 'icon-chat-bubble.svg' | inline_asset_content -}}
                {%- endcase -%}
              </span>
            {%- endif -%}
            <div class="buren-trust__content">
              {%- if block.settings.title != blank -%}
                <p class="buren-trust__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="buren-trust__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.show_payment_logos -%}
                {% render 'buren-payment-icons', context: 'trust' %}
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Garantías (Büren)",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título (opcional)"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "Mediano" },
        { "value": "h1", "label": "Grande" }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño",
      "default": "inline",
      "options": [
        { "value": "inline", "label": "Ícono al costado (barra compacta)" },
        { "value": "stacked", "label": "Ícono arriba, centrado" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Garantía",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícono",
          "default": "check_mark",
          "options": [
            { "value": "none", "label": "Ninguno" },
            { "value": "truck", "label": "Camión" },
            { "value": "lock", "label": "Candado" },
            { "value": "return", "label": "Devolución" },
            { "value": "check_mark", "label": "Check" },
            { "value": "box", "label": "Caja" },
            { "value": "chat_bubble", "label": "Mensaje" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Garantía"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "checkbox",
          "id": "show_payment_logos",
          "label": "Mostrar logos de Webpay y Mercado Pago",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Garantías (Büren)",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Envío gratis en la RM" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Pago seguro", "show_payment_logos": true } },
        { "type": "item", "settings": { "icon": "return", "title": "10 días de retracto" } }
      ]
    }
  ]
}
{% endschema %}
